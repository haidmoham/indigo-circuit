# Local DuckDB storage. Export an absolute DUCKDB_PATH in your shell when
# invoking dbt or ingest/pipeline.sh; dbt does not load this .env file itself.
# Python loaders and the dashboard default to this repository's data/ptcg.duckdb.
DBT_MARTS_SCHEMA=dbt_dev_marts

# Optional: protected Limitless decklist access.
LIMITLESS_API_KEY=

# Optional local admin endpoint authentication. Set a private value to use admin routes.
ADMIN_SECRET=

# Optional: card prices (ingest/prices.py, source: tcgcsv.com — free, keyless).
# Max HTTP requests per nightly run, lookback window for "recent" decklists,
# and the release date from which main-line sets are swept for cheaper reprints.
PRICE_MAX_CALLS=200
PRICE_LOOKBACK_DAYS=60
TCGCSV_SWEEP_SINCE=2023-03-01

# Optional: TCGplayer affiliate (Impact) tracking link. Buy links become
# <this>?u=<tcgplayer url>, or put {url} where the encoded destination goes.
# Unset => plain TCGplayer links.
TCGPLAYER_AFFILIATE_URL=
